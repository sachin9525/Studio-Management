# SVML Backend Environment Variables
NODE_ENV=production
PORT=5000

# MongoDB Connection String (e.g. MongoDB Atlas cluster URI)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/svml?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://admin:password@cluster0.mongodb.net/svml?retryWrites=true&w=majority

# JWT Secret for Session Authentication (minimum 32 random characters recommended)
JWT_SECRET=svml-super-secure-jwt-production-secret-key-32chars

# Default Admin Credentials (auto-seeded on first server startup)
ADMIN_EMAIL=admin@svml.studio
ADMIN_PASSWORD=change-this-admin-password-123

# Frontend Domain for CORS (Optional; leave empty or specify your Vercel URL)
FRONTEND_URL=https://your-frontend-app.vercel.app
